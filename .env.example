# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# ── Admin Panel (Payload CMS) ──────────────────────────────
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Local dev: SQLite file. Production (Vercel/VPS): Postgres, e.g. postgres://user:pass@host/db?sslmode=require (Neon)
DATABASE_URI=file:./data/hello-kids.db
# Public site URL, e.g. https://hellokidsschool.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First Super Admin, created by `npm run seed` (if empty, a random password is generated and written here)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Media storage (production) — Cloudflare R2 / any S3 ───
# Leave S3_BUCKET empty to store uploads in ./media (local dev / VPS with disk)
S3_BUCKET=
S3_ENDPOINT=            # e.g. https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=          # public bucket URL, e.g. https://media.hellokidsschool.com

# ── Email (Resend) ─────────────────────────────────────────
# Lead notifications + admin password reset. Without a key, emails are only logged.
RESEND_API_KEY=
MAIL_FROM=              # e.g. "Hello Kids <noreply@hellokidsschool.com>" (domain verified in Resend)
SCHOOL_EMAIL=           # inbox that receives admission / visit / contact notifications
